{# Sprint 3 scan report (Sprint 5: exceptions section and markers). Self-contained: no external fonts, scripts or
   images, so it opens offline from a CI artifact and renders the same
   way in WeasyPrint for the PDF step. #}
{% set s = summary %}
{% set state = {"PASS": "pass", "FAIL": "fail"}.get(s.status, "error") %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.status }} – {{ s.image }} – scan report</title>
<style>
  :root {
    --ink: #1d2433;
    --muted: #5f6b7a;
    --rule: #dde2e8;
    --paper: #ffffff;
    --tint: #f5f7f9;
    --pass: #17663a;
    --pass-bg: #e7f4ec;
    --fail: #a3201a;
    --fail-bg: #fbeceb;
    --error: #7a4a00;
    --error-bg: #fdf3e1;
    --sev-critical: #a3201a;
    --sev-high: #b5530c;
    --sev-medium: #8a6a00;
    --sev-low: #3d6a8f;
    --sev-unknown: #5f6b7a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 15px/1.5 "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  }
  main { max-width: 1040px; margin: 0 auto; padding: 32px 24px 48px; }

  header.meta { color: var(--muted); font-size: 14px; margin-bottom: 20px; }
  header.meta h1 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 600;
    word-break: break-all;
  }
  header.meta dl { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 24px; }
  header.meta dt { display: inline; }
  header.meta dd { display: inline; margin: 0 0 0 4px; color: var(--ink); }

  /* The verdict is the one loud element on the page. */
  .verdict {
    border-left: 8px solid;
    padding: 20px 24px;
    margin-bottom: 32px;
  }
  .verdict.pass  { border-color: var(--pass);  background: var(--pass-bg); }
  .verdict.fail  { border-color: var(--fail);  background: var(--fail-bg); }
  .verdict.error { border-color: var(--error); background: var(--error-bg); }
  .verdict h2 { margin: 0; font-size: 34px; line-height: 1.15; font-weight: 700; }
  .verdict.pass h2  { color: var(--pass); }
  .verdict.fail h2  { color: var(--fail); }
  .verdict.error h2 { color: var(--error); }
  .verdict p { margin: 8px 0 0; }
  .verdict ul { margin: 8px 0 0; padding-left: 20px; }
  .verdict pre {
    margin: 8px 0 0;
    white-space: pre-wrap;
    font: 13px/1.45 Consolas, "Courier New", monospace;
  }

  h3 { font-size: 17px; margin: 0 0 10px; }
  section { margin-bottom: 32px; }
  .note { color: var(--muted); font-size: 14px; margin: -4px 0 12px; }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-weight: 600; background: var(--tint); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.mono { font-family: Consolas, "Courier New", monospace; font-size: 13px; word-break: break-all; }

  .counts { max-width: 560px; }
  .counts tr.breached td { background: var(--fail-bg); font-weight: 600; }
  .result-ok { color: var(--pass); }
  .result-bad { color: var(--fail); }
  .result-none { color: var(--muted); }

  .sev { font-weight: 600; }
  .sev-CRITICAL { color: var(--sev-critical); }
  .sev-HIGH     { color: var(--sev-high); }
  .sev-MEDIUM   { color: var(--sev-medium); }
  .sev-LOW      { color: var(--sev-low); }
  .sev-UNKNOWN  { color: var(--sev-unknown); }
  .nofix { color: var(--muted); }

  /* Sprint 5: exceptions */
  .tag {
    display: inline-block; padding: 1px 7px; border-radius: 10px;
    font-size: 12px; font-weight: 600; white-space: nowrap;
  }
  .tag-active        { background: var(--tint);     color: var(--ink); border: 1px solid var(--rule); }
  .tag-expiring_soon { background: var(--error-bg); color: var(--error); }
  .tag-expired       { background: var(--fail-bg);  color: var(--fail); }
  .tag-unused        { background: var(--tint);     color: var(--muted); border: 1px solid var(--rule); }
  tr.waived td { color: var(--muted); }
  tr.waived td.sev { opacity: 0.7; }

  footer { color: var(--muted); font-size: 13px; border-top: 1px solid var(--rule); padding-top: 12px; }

  @media print {
    @page { size: A4; margin: 14mm; }
    main { max-width: none; padding: 0; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }

    /* A4 is narrower than a screen. Keep identifiers whole: a CVE ID
       split across lines can't be copied or searched correctly. */
    table { font-size: 12px; }
    th, td { padding: 5px 7px; }
    td.mono {
      font-size: 10.5px;
      word-break: normal;          /* no breaking mid-identifier...        */
      overflow-wrap: break-word;   /* ...unless a value truly can't fit.   */
    }
    td.cve { white-space: nowrap; }
  }
</style>
</head>
<body>
<main>

<header class="meta">
  <h1>{{ s.image }}</h1>
  <dl>
    <div><dt>Scanned</dt><dd>{{ s.scanned_at }}</dd></div>
    <div><dt>Trivy</dt><dd>{{ s.trivy_version or "not available" }}</dd></div>
    <div><dt>Findings</dt><dd>{{ s.total if state != "error" else "not available" }}</dd></div>
  </dl>
</header>

<div class="verdict {{ state }}">
  {% if state == "pass" %}
    <h2>Passed the policy gate</h2>
    <p>All gated severities are within their limits. The build can continue.</p>
  {% elif state == "fail" %}
    <h2>Blocked by the policy gate</h2>
    <p>This image exceeds the policy limits. The build is blocked until these are fixed:</p>
    <ul>
    {% for b in s.breaches %}
      <li><strong>{{ b.severity }}</strong>: {{ b.found }} found, limit is {{ b.limit }}</li>
    {% endfor %}
    </ul>
  {% else %}
    <h2>Scan did not complete</h2>
    <p>The scanner hit an error, so no pass/fail decision was made. This is a tool problem, not a policy result. Fix the error below and re-run the scan.</p>
    {% if s.error %}<pre>{{ s.error }}</pre>{% endif %}
  {% endif %}
</div>

{% if state != "error" %}
<section>
  <h3>Findings by severity</h3>
  <div class="table-wrap">
  <table class="counts">
    <thead>
      <tr><th>Severity</th><th class="num">Found</th>{% if has_exceptions %}<th class="num">Excepted</th><th class="num">Counted</th>{% endif %}<th class="num">Limit</th><th>Result</th></tr>
    </thead>
    <tbody>
    {% for row in severity_rows %}
      <tr class="{{ 'breached' if row.breached }}">
        <td class="sev sev-{{ row.name }}">{{ row.name }}</td>
        <td class="num">{{ row.count }}</td>
        {% if has_exceptions %}
        <td class="num">{{ row.excepted if row.excepted else "–" }}</td>
        <td class="num">{{ row.count - row.excepted }}</td>
        {% endif %}
        <td class="num">{{ row.limit if row.gated else "–" }}</td>
        <td>
          {% if not row.gated %}<span class="result-none">Not gated</span>
          {% elif row.breached %}<span class="result-bad">Over limit</span>
          {% else %}<span class="result-ok">Within limit</span>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

{% if has_exceptions %}
<section>
  <h3>Exceptions for this image ({{ exceptions | length }})</h3>
  <p class="note">Approved known vulnerabilities from the policy file. Excepted findings are still listed below but do not count towards the limits. An expired exception no longer applies.</p>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>CVE</th><th>Package</th><th>State</th><th>Expires</th><th class="num">Matched</th><th>Approved</th><th>Reason</th></tr>
    </thead>
    <tbody>
    {% for e in exceptions %}
      {% set unused = e.matched == 0 and e.state != "expired" %}
      <tr>
        <td class="mono cve">{{ e.id }}</td>
        <td class="mono">{{ e.package or "any" }}</td>
        <td>
          {% if e.state == "expired" %}<span class="tag tag-expired">Expired{{ ", counted again" if e.matched }}</span>
          {% elif unused %}<span class="tag tag-unused">Not found: remove?</span>
          {% elif e.state == "expiring_soon" %}<span class="tag tag-expiring_soon">Expires in {{ e.days_left }} day{{ "s" if e.days_left != 1 }}</span>
          {% else %}<span class="tag tag-active">Active</span>{% endif %}
        </td>
        <td class="mono">{{ e.expires }}</td>
        <td class="num">{{ e.matched }}</td>
        <td>{{ e.approved_by }}, {{ e.approved_on }}</td>
        <td>{{ e.reason }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if excepted_fixable %}
  <p class="note" style="margin-top:10px">A fix is now available for: <strong>{{ excepted_fixable | join(", ") }}</strong>. Patch instead of renewing the exception.</p>
  {% endif %}
</section>
{% endif %}

<section>
  <h3>Vulnerabilities ({{ vulns | length }})</h3>
  {% if vulns %}
  <p class="note">{{ fixable }} of {{ vulns | length }} have a fixed version available. Most severe first.{% if excepted_count %} {{ excepted_count }} excepted (shown greyed out).{% endif %}</p>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>CVE</th><th>Severity</th><th>Package</th><th>Installed</th><th>Fixed in</th>{% if excepted_count %}<th>Exception</th>{% endif %}</tr>
    </thead>
    <tbody>
    {% for v in vulns %}
      <tr class="{{ 'waived' if v.exception }}">
        <td class="mono cve">{{ v.id }}</td>
        <td class="sev sev-{{ v.severity }}">{{ v.severity }}</td>
        <td class="mono">{{ v.package }}</td>
        <td class="mono">{{ v.installed }}</td>
        <td class="mono">{% if v.fixed %}{{ v.fixed }}{% else %}<span class="nofix">No fix yet</span>{% endif %}</td>
        {% if excepted_count %}<td>{% if v.exception %}<span class="tag tag-active">Until {{ v.exception.expires }}</span>{% endif %}</td>{% endif %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p>No known vulnerabilities were found in this image.</p>
  {% endif %}
</section>
{% endif %}

<footer>
  {% if state == "error" %}
  Generated from scan-summary.json. No Trivy report exists because the scan did not complete. Scanner exit code {{ s.exit_code }}.
  {% else %}
  Generated from scan-summary.json and trivy-report.json. The verdict above is the same decision the CI gate made, exit code {{ s.exit_code }}.
  {% endif %}
</footer>

</main>
</body>
</html>
