# Copy to monitoring/.env and fill in. monitoring/.env is never committed.
# Enter values with an editor or `read -s`; never paste them into chat.

# GitHub fine-grained PAT: this repo only, Actions: Read-only
GITHUB_TOKEN=

# Jenkins user and API token.
# JENKINS_USER is your Jenkins user ID (the <id> in your profile URL /user/<id>/),
# not the display name: the display name gives HTTP 401 Unauthorized.
# API token: Jenkins > your name > Security > API Token
JENKINS_USER=
JENKINS_TOKEN=

# Grafana admin password (only applied the first time Grafana starts)
GRAFANA_ADMIN_PASSWORD=
