    {
      "id": 4,
      "type": "timeseries",
      "title": "Found vs resolved per day",
      "description": "Found: vulnerabilities not in the previous scan of the same image. Resolved: in the previous scan, gone now. Main-branch scans only.",
      "datasource": {
        "type": "prometheus",
        "uid": "vuln-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "interval": "1d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "round(sum(max by (image) (sum by (source, image) (increase(vuln_found_total{source=~\"$source\",image=~\"$image\",severity=~\"$severity\"}[$__interval])))))",
          "legendFormat": "Found",
          "range": true,
          "instant": false,
          "format": "time_series",
          "interval": "1d"
        },
        {
          "refId": "B",
