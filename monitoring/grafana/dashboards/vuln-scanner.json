    {
      "id": 6,
      "type": "table",
      "title": "Latest status per image",
      "description": "Latest main-branch scan of each image within the selected date range. Open vulnerabilities follow the severity filter; the result itself does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "vuln-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "last_over_time(scan_last_result{source=~\"$source\",image=~\"$image\"}[$__range])",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "last_over_time(scan_last_timestamp_seconds{source=~\"$source\",image=~\"$image\"}[$__range]) * 1000",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "image": 0,
              "source": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            },
            "renameByName": {
              "image": "Image",
              "source": "Source",
              "Value #A": "Last result",
              "Value #B": "Last scan",
              "Value #C": "Open vulnerabilities"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "PASS",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "BLOCKED",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "ERROR",
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last scan"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Open vulnerabilities"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
