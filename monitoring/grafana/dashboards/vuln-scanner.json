          "expr": "round(sum(max by (image) (sum by (source, image) (increase(vuln_resolved_total{source=~\"$source\",image=~\"$image\",severity=~\"$severity\"}[$__interval])))))",
          "legendFormat": "Resolved",
          "range": true,
          "instant": false,
