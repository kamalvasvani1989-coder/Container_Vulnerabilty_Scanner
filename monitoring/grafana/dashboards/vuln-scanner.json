{
  "uid": "vuln-scanner",
  "title": "Container Vulnerability Scanner",
  "description": "Sprint 4: vulnerability trends from GitHub Actions and Jenkins scans (found, resolved, pending).",
  "tags": [
    "vuln-scanner",
    "trivy"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "skipUrlSync": false,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vuln-prometheus"
        },
        "query": {
          "query": "label_values(vuln_pending, source)",
          "refId": "var"
        },
        "definition": "label_values(vuln_pending, source)",
        "refresh": 2,
        "sort": 1,
        "regex": ""
      },
      {
        "name": "image",
        "label": "Image",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "skipUrlSync": false,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vuln-prometheus"
        },
        "query": {
          "query": "label_values(vuln_pending{source=~\"$source\"}, image)",
          "refId": "var"
        },
        "definition": "label_values(vuln_pending{source=~\"$source\"}, image)",
        "refresh": 2,
        "sort": 1,
        "regex": ""
      },
      {
        "name": "severity",
        "label": "Severity",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "skipUrlSync": false,
        "type": "custom",
        "query": "CRITICAL,HIGH,MEDIUM,LOW,UNKNOWN",
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "CRITICAL",
            "value": "CRITICAL",
            "selected": false
          },
          {
            "text": "HIGH",
            "value": "HIGH",
            "selected": false
          },
          {
            "text": "MEDIUM",
            "value": "MEDIUM",
            "selected": false
          },
          {
            "text": "LOW",
            "value": "LOW",
            "selected": false
          },
          {
            "text": "UNKNOWN",
            "value": "UNKNOWN",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open vulnerabilities by severity",
      "description": "Vulnerabilities open at the end of the selected date range (now, if the range reaches today), from the latest main-branch scan of the selected images. An image scanned by both GitHub and Jenkins is counted once.",
      "datasource": {
        "type": "prometheus",
        "uid": "vuln-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum(max by (image) (sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\",severity=\"CRITICAL\"}[$__range]))))",
          "legendFormat": "CRITICAL",
          "range": false,
          "instant": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum(max by (image) (sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\",severity=\"HIGH\"}[$__range]))))",
          "legendFormat": "HIGH",
          "range": false,
          "instant": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum(max by (image) (sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\",severity=\"MEDIUM\"}[$__range]))))",
          "legendFormat": "MEDIUM",
          "range": false,
          "instant": true,
          "format": "time_series"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum(max by (image) (sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\",severity=\"LOW\"}[$__range]))))",
          "legendFormat": "LOW",
          "range": false,
          "instant": true,
          "format": "time_series"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "vuln-prometheus"
          },
          "expr": "sum(max by (image) (sum by (source, image) (last_over_time(vuln_pending{source=~\"$source\",image=~\"$image\",severity=~\"$severity\",severity=\"UNKNOWN\"}[$__range]))))",
          "legendFormat": "UNKNOWN",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
